.class public final Lio/github/ewfefrs/g2snap/R;
.super Ljava/lang/Object;


# annotations
.annotation system Ldalvik/annotation/MemberClasses;
    value = {
        Lio/github/ewfefrs/g2snap/R$color;,
        Lio/github/ewfefrs/g2snap/R$drawable;,
        Lio/github/ewfefrs/g2snap/R$id;,
        Lio/github/ewfefrs/g2snap/R$layout;,
        Lio/github/ewfefrs/g2snap/R$mipmap;,
        Lio/github/ewfefrs/g2snap/R$string;,
        Lio/github/ewfefrs/g2snap/R$style;,
        Lio/github/ewfefrs/g2snap/R$xml;
    }
.end annotation


# direct methods
.method private constructor <init>()V
    .locals 0

    invoke-direct {p0}, Ljava/lang/Object;-><init>()V

    return-void
.end method
