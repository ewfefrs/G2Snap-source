<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="5.0dp" android:color="#88ffffff" />
                </shape>
            </item>
            <item android:left="12.0dp" android:top="12.0dp" android:right="12.0dp" android:bottom="12.0dp">
                <shape android:shape="oval">
                    <solid android:color="#88ffffff" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="5.0dp" android:color="#ffffff" />
                </shape>
            </item>
            <item android:left="16.0dp" android:top="16.0dp" android:right="16.0dp" android:bottom="16.0dp">
                <shape android:shape="oval">
                    <solid android:color="#dddddd" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="5.0dp" android:color="#ffffff" />
                </shape>
            </item>
            <item android:left="12.0dp" android:top="12.0dp" android:right="12.0dp" android:bottom="12.0dp">
                <shape android:shape="oval">
                    <solid android:color="#ffffff" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
