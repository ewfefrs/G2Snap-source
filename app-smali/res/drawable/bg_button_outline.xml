<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#332bd97a" />
            <stroke android:width="1.0dp" android:color="@color/accent" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/card" />
            <stroke android:width="1.0dp" android:color="#443ddc84" />
            <corners android:radius="14.0dp" />
        </shape>
    </item>
</selector>
